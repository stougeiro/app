{
  "defaults": {
    "ssh": {
      "host": "example.com",
      "port": 22,
      "user": "deploy",
      "identity": ".deploy/ssh/deploy_ed25519"
    },
    "root": {
      "base": "/home/deploy/domains/example.com"
    },
    "preserve": [
      "/.well-known/***"
    ],
    "backup": {
      "keep": 3
    }
  },
  "targets": {
    "development": {
      "root": {
        "dir": "dev"
      },
      "webroot": "/home/deploy/domains/example.com/public_html/dev",
      "url": "https://dev.example.com"
    },
    "staging": {
      "root": {
        "dir": "staging"
      },
      "webroot": "/home/deploy/domains/example.com/public_html/staging",
      "url": "https://test.example.com"
    },
    "production": {
      "webroot": "/home/deploy/domains/example.com/public_html",
      "url": "https://example.com",
      "backup": {
        "keep": 5
      }
    }
  }
}
