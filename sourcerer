#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="stougeiro/sourcerer:local"

if ! command -v docker >/dev/null 2>&1; then
    echo "error: docker is required" >&2
    exit 1
fi

DOCKERFILE="$ROOT/tools/manager/Dockerfile"
DOCKERFILE_HASH="$(sha256sum "$DOCKERFILE" | cut -d' ' -f1)"
IMAGE_ID="$(docker image inspect -f '{{.Id}}' "$IMAGE" 2>/dev/null || true)"
IMAGE_HASH="$(docker image inspect -f '{{ index .Config.Labels "sourcerer.dockerfile" }}' "$IMAGE" 2>/dev/null || true)"

if [ -z "$IMAGE_ID" ] || [ "$IMAGE_HASH" != "$DOCKERFILE_HASH" ]; then
    echo "building image $IMAGE..." >&2
    docker build -q --label "sourcerer.dockerfile=$DOCKERFILE_HASH" -t "$IMAGE" "$ROOT/tools/manager" >/dev/null
fi

DOCKER_ARGS=(run --rm -i --add-host=host.docker.internal:host-gateway)
if [ -t 0 ] && [ -t 1 ]; then
    DOCKER_ARGS+=(-t)
fi

DOCKER_ARGS+=(
    --user "$(id -u):$(id -g)"
    -e HOME=/tmp
    -e COMPOSER_ALLOW_SUPERUSER=1
    -v "$ROOT:/work"
    -w /work
)

if [ -n "${DEPLOY_VERSION:-}" ]; then
    DOCKER_ARGS+=(-e "DEPLOY_VERSION=$DEPLOY_VERSION")
fi

if [ "$(id -u)" != "0" ]; then
    PASSWD_FILE="$(mktemp)"
    trap 'rm -f "$PASSWD_FILE"' EXIT
    chmod 0644 "$PASSWD_FILE"

    {
        printf 'root:x:0:0:root:/root:/bin/sh\n'
        printf '%s:x:%s:%s:%s:/tmp:/bin/sh\n' \
            "$(id -un)" "$(id -u)" "$(id -g)" "$(id -un)"
    } > "$PASSWD_FILE"

    DOCKER_ARGS+=(-v "$PASSWD_FILE:/etc/passwd:ro")
fi

if [ -d "${HOME}/.ssh" ]; then
    DOCKER_ARGS+=(-v "${HOME}/.ssh:/tmp/.ssh")
fi

if [ -d "${HOME}/.cache/composer" ]; then
    DOCKER_ARGS+=(-v "${HOME}/.cache/composer:/tmp/.cache/composer")
fi

docker "${DOCKER_ARGS[@]}" "$IMAGE" php /work/tools/manager/console.php "$@"
