{
    "name": "stougeiro/app",
    "description": "A small PHP 8.2 modular application foundation for shared hosting.",
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "php82",
        "application",
        "shared-hosting",
        "apache",
        "modules",
        "http",
        "microframework",
        "logging",
        "error-handling"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/app/issues",
        "source": "https://github.com/stougeiro/app"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "application/module/",
            "App\\Core\\": "application/core/",
            "App\\Database\\": "application/database/",
            "App\\Provider\\": "application/provider/"
        }
    },
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "stougeiro/base": "^0.5.0",
        "stougeiro/base-contract": "^0.1.1",
        "stougeiro/container": "^4.0",
        "stougeiro/http": "^2.2",
        "stougeiro/router": "^1.0",
        "stougeiro/view": "^2.0",
        "stougeiro/cache": "^2.0",
        "stougeiro/session": "^2.0",
        "stougeiro/event": "^1.0",
        "stougeiro/pdo-database": "^1.0",
        "stougeiro/support": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Sourcerer\\Tool\\Contract\\": "tools/contract/src/",
            "Sourcerer\\Tool\\Manager\\": "tools/manager/src/",
            "Sourcerer\\Tool\\Code\\": "tools/code/src/",
            "Sourcerer\\Tool\\Schema\\": "tools/schema/src/",
            "Sourcerer\\Tool\\Support\\": "tools/support/src/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8"
    },
    "scripts": {
        "stan": "vendor/bin/phpstan",
        "pest": "vendor/bin/pest",
        "cover": "vendor/bin/pest --coverage",
        "cover:app": "vendor/bin/pest --coverage --coverage-filter=application",
        "cover:code": "vendor/bin/pest tests/Feature/Code --coverage --coverage-filter=tools/code/src",
        "cover:schema": "vendor/bin/pest tests/Feature/Schema --coverage --coverage-filter=tools/schema/src"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
