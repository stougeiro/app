{
    "name": "stougeiro/app",
    "description": "",
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
    ],
    "support": {
        "issues": "https://github.com/stougeiro/app/issues",
        "source": "https://github.com/stougeiro/app"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Contract\\": "contract/",
            "App\\Database\\": "database/",
            "App\\Provider\\": "provider/"
        }
    },
    "require": {
        "php": ">=8.2",
        "stougeiro/base": "^0.4.0",
        "stougeiro/view": "^2.0",
        "stougeiro/cache": "^2.0",
        "stougeiro/session": "^2.0",
        "stougeiro/event": "^1.0",
        "stougeiro/pdo-database": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8"
    },
    "scripts": {
        "stan": "vendor/bin/phpstan",
        "pest": "vendor/bin/pest",
        "cover": "vendor/bin/pest --coverage",
        "bench": "BENCH=1 vendor/bin/pest tests/Performance"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
