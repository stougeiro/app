parameters:
    level: 9
    paths:
        - application/module
        - application/bootstrap
        - application/core
        - application/database
        - application/provider
        - public
        - tools/contract/src
        - tools/deploy/src
        - tools/cli/src
        - tools/cli/bootstrap.php
        - tools/cli/console.php
        - tools/cli/tools.php
    excludePaths:
        - application/module/*/View/*
    bootstrapFiles:
        - application/bootstrap/app.php
