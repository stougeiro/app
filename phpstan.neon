parameters:
    level: 9
    paths:
        - application/module
        - application/bootstrap
        - application/core
        - application/database
        - application/provider
        - public
        - tools/contract/src
        - tools/code/src
        - tools/schema/src
        - tools/manager/src
        - tools/manager/console.php
        - tools/manager/tools.php
    excludePaths:
        - application/module/*/View/*
    bootstrapFiles:
        - application/bootstrap/app.php
